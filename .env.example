POSTGRES_USER=postgres
POSTGRES_PASSWORD=xxxx
POSTGRES_DB=foodstore_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:xxxx@localhost:5432/foodstore_db

# JWT: clave de al menos 32 caracteres aleatorios.
# Para generarla: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=completar
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30